<w:document xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml"><w:body><w:p w14:paraId="5C0B453E" w14:textId="5C0B453E"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Clause 7 — Confidentiality</w:t></w:r></w:p><w:p w14:paraId="5D0B46D1" w14:textId="5D0B46D1"><w:r><w:t xml:space="preserve">The </w:t></w:r><w:ins w:author="Test Author" w:date="2026-09-01T18:47:10Z" w:id="0"><w:r><w:t>Recipient</w:t></w:r></w:ins><w:del w:author="Test Author" w:date="2026-09-01T18:47:10Z" w:id="0"><w:r><w:delText>Receiving Party</w:delText></w:r></w:del><w:r><w:t xml:space="preserve"> shall hold the Confidential Information in strict confidence and shall not disclose it to any third party.</w:t></w:r></w:p><w:p w14:paraId="5A0B4218" w14:textId="5A0B4218"><w:r><w:t>The obligations in this Clause 7 shall survive for a period of five years from the date of termination.</w:t></w:r></w:p><w:p w14:paraId="5B0B43AB" w14:textId="5B0B43AB"><w:r><w:t>Nothing in this Clause 7 restricts disclosure required by applicable law or by any competent regulatory authority.</w:t></w:r></w:p><w:sectPr><w:pgSz w:h="15840" w:w="12240"/><w:pgMar w:bottom="1440" w:footer="720" w:gutter="0" w:header="720" w:left="1440" w:right="1440" w:top="1440"/></w:sectPr></w:body></w:document>